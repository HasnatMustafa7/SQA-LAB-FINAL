
package newpackage;

import java.time.Duration;

import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.By;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.support.ui.WebDriverWait;
import org.openqa.selenium.support.ui.ExpectedConditions;

public class MyClass {

    public static void main(String[] args) {

        System.setProperty("webdriver.chrome.driver",
                "D:\\New folder (2)\\chromedriver-win64\\chromedriver.exe");

        WebDriver driver = new ChromeDriver();

        try {

        
            driver.get("https://bikroy.com/");

           
            driver.manage().window().maximize();

            
            WebDriverWait wait = new WebDriverWait(
                    driver, Duration.ofSeconds(15));

          
            WebElement electronicsCategory = wait.until(
                    ExpectedConditions.elementToBeClickable(
                            By.xpath("//span[contains(@class,'qa-category-parent-name') and normalize-space()='Electronics']")
                    )
            );

            electronicsCategory.click();

            System.out.println("Electronics category clicked!");

           
            WebElement nextElement = wait.until(
                    ExpectedConditions.elementToBeClickable(
                            By.xpath("//*[@id='__nuxt']/div/div[2]/div/div/div/div/div[2]/div[2]/div[1]/div[1]/div[2]/ul/li[1]/a/div[1]")
                    )
            );

            nextElement.click();

            System.out.println("Second element clicked successfully!");

          
            WebElement product = wait.until(
                    ExpectedConditions.elementToBeClickable(
                            By.xpath("//*[@id='__nuxt']/div/div[2]/div/div/div/div/div[2]/div[2]/div[2]/div/div/div[3]/div/div/div[1]/div/div[1]/div[1]/a")
                    )
            );

            product.click();

            System.out.println("Product clicked successfully!");

        } catch (Exception e) {

            e.printStackTrace();

        } finally {

         
        }
    }
}
